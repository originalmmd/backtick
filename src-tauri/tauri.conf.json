{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Backtick",
  "version": "0.2.2",
  "identifier": "app.backtick",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "vite dev --port 1420",
    "beforeBuildCommand": "vite build"
  },
  "app": {
    "windows": [
      {
        "title": "Backtick",
        "width": 900,
        "height": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd"],
        "mimeType": "text/markdown",
        "name": "markdown",
        "description": "Markdown Document",
        "role": "Editor"
      }
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/share/applications/backtick.desktop": "gen/deb/backtick.desktop",
          "/usr/share/kio/servicemenus/backtick.desktop": "gen/kio/servicemenus/backtick.desktop"
        }
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "infoPlist": "gen/macos/Info.plist"
    },
    "windows": {
      "wix": {
        "fragmentPaths": [
          "wix/license.wxs"
        ]
      }
    }
  }
}
